DATABASE_URL=postgresql://user:password@localhost:5432/ifdc
JWT_SECRET=change-me-to-a-long-random-string

# Default admin account (created on first start if it does not exist)
ADMIN_EMAIL=admin@ifdchild.org
ADMIN_PASSWORD=change-me

# Where uploaded images and PDFs are stored.
# Locally this is the "uploads" folder; on Railway set it to the volume mount path (e.g. /data).
UPLOAD_DIR=uploads

# Public sites allowed to call this API, comma separated (localhost is always allowed).
# e.g. https://ifdchild.org,https://www.ifdchild.org,https://admin.ifdchild.org
ALLOWED_ORIGINS=

# Email notifications (donation requests). For Gmail use an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ifdchild@gmail.com
SMTP_PASSWORD=
SMTP_FROM=ifdchild@gmail.com
ADMIN_NOTIFY_EMAIL=ifdchild@gmail.com
ADMIN_DASHBOARD_URL=http://localhost:5181
